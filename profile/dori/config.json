{
  "name": "Dori",
  "stateDir": "~/.dori/state",
  "laneWorkspace": "",
  "workspaces": [],
  "ignorePanes": [],
  "leadPane": "",
  "defaultCwd": "~",
  "agentCommand": ["omo", "--model", "{model}", "{prompt}"],
  "paneShell": "auto",
  "defaultModel": "anthropic/claude-opus-5-5",
  "launchKeywords": "ulw set goal and work",
  "sessionsDir": "~/.omo/agent/sessions",
  "nudgeAfterMin": 15,
  "postAfterMin": 20,
  "closeAfterMin": 5,
  "heavySlots": 1,
  "heavyMaxLoad": 80,
  "deadPanePatterns": ["has stopped", "no suitable jobs"],
  "guard": {
    "loadAlert": 150,
    "loadOk": 80,
    "memFreeMinPct": 20,
    "diskFreeMinGb": 50,
    "panesMax": 20
  },
  "hooks": {
    "autostart": [
      "powershell",
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "{src}/profile/install-profile.ps1",
      "-TaskOnly"
    ]
  }
}
