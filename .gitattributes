# Shell scripts must stay LF (bash rejects CR); cmd scripts must stay CRLF (cmd.exe label/line parsing). Other files are left alone.
*.sh text eol=lf
*.cmd text eol=crlf
# Screen fixtures are compared line by line, and the container files run inside Linux: keep them LF on Windows checkouts.
test/fixtures/screens/*.txt text eol=lf
examples/container/Dockerfile text eol=lf
examples/container/*.yaml text eol=lf
# biome checks these files with LF line endings: keep them LF on Windows checkouts too (CI runners and users with
# core.autocrlf=true would otherwise fail biome format).
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
